#include <windows.h>

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
1                       ICON                    ".\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,0,1,0
 PRODUCTVERSION 4,0,1,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VTFEdit"
            VALUE "FileVersion", "4.0.1"
            VALUE "InternalName", "VTFEdit"
            VALUE "LegalCopyright", "Copyright (C) 2026 ficool2, 2020 misyltoad, 2005-2011 Neil Jedrzejewski & Ryan Gregg"
            VALUE "OriginalFilename", "VTFEdit++.exe"
            VALUE "ProductName", "VTFEdit++"
            VALUE "ProductVersion", "4.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
